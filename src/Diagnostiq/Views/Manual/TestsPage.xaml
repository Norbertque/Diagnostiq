<UserControl x:Class="Diagnostiq.Views.Manual.TestsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:Diagnostiq.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="{StaticResource Diag.Page.MaxWidth}">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Diag.Text.Title}" Text="Tests" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Style="{StaticResource Diag.Text.Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"
                               Text="Run any test on its own, as often as you like. The latest result of each goes into the report." />
                </StackPanel>
                <ui:Button Grid.Column="1" Appearance="Primary" Content="Run automatic check" Icon="{ui:SymbolIcon Play24}" MinHeight="40"
                           VerticalAlignment="Center" Margin="16,0,0,0" Click="RunAll_Click" />
            </Grid>

            <!-- Stress test: pick parts and length. -->
            <Border Style="{StaticResource Diag.Card}" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <!-- DockPanel and WrapPanels, not horizontal StackPanels, so the caption and choices wrap in a narrow column. -->
                        <DockPanel>
                            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Flash24" FontSize="20" Margin="0,2,12,0" VerticalAlignment="Top"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Diag.Text.Subtitle}" Text="Stress test" FontSize="18" AutomationProperties.HeadingLevel="Level2" />
                                <TextBlock Style="{StaticResource Diag.Text.Caption}" Text="Loads the chosen parts flat out and watches temperature and clock speed." />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Diag.Text.BodyStrong}" Text="Parts" Margin="32,16,0,4" />
                        <WrapPanel Margin="32,0,0,0">
                            <CheckBox x:Name="CpuCheck" Content="Processor" IsChecked="True" MinWidth="0" Margin="0,0,20,4" />
                            <CheckBox x:Name="MemoryCheck" Content="Memory" IsChecked="True" MinWidth="0" Margin="0,0,20,4" />
                            <CheckBox x:Name="ScanCheck" Content="Disk surface scan" IsChecked="True" MinWidth="0" Margin="0,0,20,4" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Diag.Text.BodyStrong}" Text="Length" Margin="32,8,0,4" />
                        <WrapPanel Margin="32,0,0,0">
                            <RadioButton x:Name="QuickRadio" GroupName="ManualDuration" Content="2 min" MinWidth="0" Margin="0,0,20,4" />
                            <RadioButton x:Name="StandardRadio" GroupName="ManualDuration" Content="5 min" IsChecked="True" MinWidth="0" Margin="0,0,20,4" />
                            <RadioButton x:Name="ExtendedRadio" GroupName="ManualDuration" Content="15 min" MinWidth="0" Margin="0,0,20,4" />
                        </WrapPanel>
                        <ui:Button x:Name="StressRun" Content="Run stress test" Icon="{ui:SymbolIcon Play24}" MinHeight="36"
                                   Margin="32,12,0,0" Click="Stress_Click" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource Diag.Text.BodyStrong}" Text="Last results" Margin="0,4,0,8" />
                        <ItemsControl x:Name="StressResults" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <c:StatusPill Text="{Binding Label}" State="{Binding State}" VerticalAlignment="Top" Margin="0,0,10,0" MinWidth="72" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource Diag.Text.Body}" Text="{Binding Text}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource Diag.Text.Subtitle}" Text="Individual tests" Margin="0,0,0,12" AutomationProperties.HeadingLevel="Level2" />
            <c:ColumnsPanel x:Name="HandsOn" Columns="3" Margin="0,0,-12,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
