<UserControl x:Class="Diagnostiq.Views.LoadingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Diagnostiq.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="560" Margin="32,24,32,32" VerticalAlignment="Center">
            <Image Source="/Assets/icon.png" Width="56" Height="56" HorizontalAlignment="Left"
                   RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,20" />
            <TextBlock Style="{StaticResource Diag.Text.Title}" Text="Checking this laptop"
                       AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="Hint" Style="{StaticResource Diag.Text.Body}" Margin="0,6,0,20"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Reading the hardware in the background. This usually takes 5 to 20 seconds." />

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="Bar" Height="4" VerticalAlignment="Center" Minimum="0"
                             AutomationProperties.Name="Progress" />
                <TextBlock x:Name="Counter" Grid.Column="1" Style="{StaticResource Diag.Text.Caption}"
                           Margin="12,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"
                           AutomationProperties.LiveSetting="Polite" />
            </Grid>

            <Border Style="{StaticResource Diag.Card}" Padding="16,8">
                <ItemsControl x:Name="StepList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <c:StatusIcon State="{Binding State}" Size="18" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Diag.Text.Body}" Margin="12,0"
                                           Text="{Binding Label}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Style="{StaticResource Diag.Text.Caption}"
                                           Text="{Binding StatusText}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
