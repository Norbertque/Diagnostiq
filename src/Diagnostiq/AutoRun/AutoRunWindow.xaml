<Window x:Class="Diagnostiq.AutoRun.AutoRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Diagnostiq: Automatic check"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized" Topmost="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar: where you are, verdict buttons, exit. Keyboard-reachable too; the keyboard slide's
             hook swallows every key, so pressing keys there can't trigger them. -->
        <Border x:Name="TopBar" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StepCounter" Style="{StaticResource Diag.Text.Caption}" />
                    <TextBlock x:Name="StepTitle" Style="{StaticResource Diag.Text.Subtitle}" FontSize="18" LineHeight="24" />
                </StackPanel>

                <!-- Shrinks on narrow screens rather than being cut off by the verdict buttons. -->
                <Viewbox x:Name="SegmentsBox" Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Margin="24,0">
                    <StackPanel x:Name="Segments" Orientation="Horizontal" />
                </Viewbox>

                <!-- Big and far apart, with coloured icons, so Fail isn't hit when Pass (or Exit) was meant. -->
                <StackPanel x:Name="VerdictButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="FailButton" Content="Fail" Icon="{ui:SymbolIcon DismissCircle24}" MinWidth="120" MinHeight="48"
                               FontSize="16" Click="Fail_Click" />
                    <ui:Button x:Name="SkipButton" Content="Skip" Icon="{ui:SymbolIcon Next24}" Appearance="Transparent" MinWidth="120"
                               MinHeight="48" FontSize="16" Margin="8,0" Click="Skip_Click" />
                    <ui:Button x:Name="PassButton" Content="Pass" Icon="{ui:SymbolIcon CheckmarkCircle24}" MinWidth="120" MinHeight="48"
                               FontSize="16" Click="Pass_Click" />
                </StackPanel>

                <ui:Button x:Name="ExitButton" Grid.Column="3" Content="Exit" Appearance="Transparent" Icon="{ui:SymbolIcon SignOut24}"
                           MinHeight="40" Margin="24,0,0,0" VerticalAlignment="Center" Click="Exit_Click" />
            </Grid>
        </Border>

        <ContentControl x:Name="Stage" Grid.Row="1" Focusable="False" IsTabStop="False" />

        <ui:ContentDialogHost x:Name="DialogHost" Grid.RowSpan="2" />
    </Grid>
</Window>
