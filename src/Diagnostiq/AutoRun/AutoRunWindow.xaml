<Window x:Class="Diagnostiq.AutoRun.AutoRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Diagnostiq: Automatic check"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized" Topmost="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar: where you are, verdict buttons, exit. Mouse/touchpad only: keys are for testing. -->
        <Border x:Name="TopBar" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StepCounter" Style="{StaticResource Diag.Text.Caption}" />
                    <TextBlock x:Name="StepTitle" Style="{StaticResource Diag.Text.Subtitle}" FontSize="18" LineHeight="24" />
                </StackPanel>

                <StackPanel x:Name="Segments" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Margin="24,0" AutomationProperties.Name="Progress through the steps" />

                <StackPanel x:Name="VerdictButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="FailButton" Content="Fail" Icon="{ui:SymbolIcon Dismiss24}" MinWidth="96" MinHeight="40"
                               Click="Fail_Click" Focusable="False" />
                    <ui:Button x:Name="SkipButton" Content="Skip" Appearance="Transparent" MinWidth="80" MinHeight="40" Margin="8,0"
                               Click="Skip_Click" Focusable="False" />
                    <ui:Button x:Name="PassButton" Content="Pass" Icon="{ui:SymbolIcon Checkmark24}" MinWidth="96" MinHeight="40"
                               Click="Pass_Click" Focusable="False" />
                </StackPanel>

                <ui:Button x:Name="ExitButton" Grid.Column="3" Content="Exit" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss24}"
                           MinHeight="40" Margin="24,0,0,0" VerticalAlignment="Center" Click="Exit_Click" Focusable="False" />
            </Grid>
        </Border>

        <ContentControl x:Name="Stage" Grid.Row="1" Focusable="False" IsTabStop="False" />

        <ui:ContentDialogHost x:Name="DialogHost" Grid.RowSpan="2" />
    </Grid>
</Window>
