<auto:StepView x:Class="Diagnostiq.AutoRun.Steps.KeyboardStep"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
               xmlns:auto="clr-namespace:Diagnostiq.AutoRun">
    <Grid Margin="48,32,48,32" MaxWidth="1240">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource Diag.Text.Title}" Text="Keyboard" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Style="{StaticResource Diag.Text.Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,24,0" MaxWidth="820" HorizontalAlignment="Left"
                           Text="Press every key once; each one turns green when it works. Esc, Windows and Alt+Tab are captured here, so they won't close anything. Fn can't be detected on its own: test it with the brightness or volume keys." />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                <TextBlock x:Name="Counter" Style="{StaticResource Diag.Text.Metric}" HorizontalAlignment="Right" />
                <TextBlock Style="{StaticResource Diag.Text.Caption}" Text="keys working" HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>

        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both" Margin="0,24" MaxHeight="440">
            <StackPanel x:Name="Board" />
        </Viewbox>

        <StackPanel Grid.Row="2">
            <TextBlock x:Name="Missing" Style="{StaticResource Diag.Text.Body}" />
            <TextBlock x:Name="Others" Style="{StaticResource Diag.Text.Caption}" Margin="0,6,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Style="{StaticResource Diag.Text.Caption}" Text="Keyboard shape:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ui:Button x:Name="IsoButton" Content="ISO (Europe)" Padding="10,4" Focusable="False" Click="Iso_Click" />
                <ui:Button x:Name="AnsiButton" Content="ANSI (US)" Padding="10,4" Margin="6,0,0,0" Focusable="False" Click="Ansi_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</auto:StepView>
