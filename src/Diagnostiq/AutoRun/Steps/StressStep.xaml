<auto:StepView x:Class="Diagnostiq.AutoRun.Steps.StressStep"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
               xmlns:auto="clr-namespace:Diagnostiq.AutoRun"
               xmlns:c="clr-namespace:Diagnostiq.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1240" Margin="48,32,48,32">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Style="{StaticResource Diag.Text.Title}" Text="Stress test" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock x:Name="Intro" Style="{StaticResource Diag.Text.Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,6,24,0" MaxWidth="760" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                    <TextBlock x:Name="Remaining" Style="{StaticResource Diag.Text.Display}" HorizontalAlignment="Right"
                               AutomationProperties.Name="Time remaining" />
                    <TextBlock Style="{StaticResource Diag.Text.Caption}" Text="remaining" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
            <ProgressBar x:Name="Bar" Height="4" Margin="0,16,0,24" Maximum="1" AutomationProperties.Name="Stress test progress" />

            <c:ColumnsPanel Columns="4" Margin="0,0,-12,0">
                <c:MetricCard x:Name="TempCard" Label="CPU temperature" Icon="Temperature24" />
                <c:MetricCard x:Name="ClockCard" Label="CPU speed" Icon="Flash24" />
                <c:MetricCard x:Name="LoadCard" Label="CPU load" Icon="DataUsage24" />
                <c:MetricCard x:Name="FanCard" Label="Fan" Icon="ArrowSync24" />
            </c:ColumnsPanel>

            <c:ColumnsPanel Columns="2" Margin="0,0,-12,0">
                <Border Style="{StaticResource Diag.Card}" Margin="0,0,12,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:StatusIcon x:Name="MemoryIcon" VerticalAlignment="Top" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Diag.Text.BodyStrong}" Text="Memory test" />
                            <TextBlock x:Name="MemoryText" Style="{StaticResource Diag.Text.Body}" Text="Allocating memory…" />
                            <TextBlock x:Name="MemorySub" Style="{StaticResource Diag.Text.Caption}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Diag.Card}" Margin="0,0,12,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:StatusIcon x:Name="ScanIcon" VerticalAlignment="Top" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Diag.Text.BodyStrong}" Text="Disk surface scan" />
                            <TextBlock x:Name="ScanText" Style="{StaticResource Diag.Text.Body}" Text="Starting…" />
                            <TextBlock x:Name="ScanSub" Style="{StaticResource Diag.Text.Caption}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </c:ColumnsPanel>

            <Border x:Name="BatteryCard" Style="{StaticResource Diag.Banner.Info}" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon x:Name="BatteryIcon" Symbol="PlugDisconnected24" FontSize="20" VerticalAlignment="Top" Margin="0,1,12,0"
                                   Foreground="{DynamicResource Diag.InfoForegroundBrush}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="BatteryTitle" Style="{StaticResource Diag.Text.BodyStrong}" Text="Optional: measure the battery under load" />
                        <TextBlock x:Name="BatteryText" Style="{StaticResource Diag.Text.Body}"
                                   Text="Unplug the charger now and the rest of the run doubles as a battery drain test. You'll be asked to plug it back in later." />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</auto:StepView>
