<UserControl x:Class="Diagnostiq.AutoRun.SummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Diagnostiq.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="960" Margin="48,40,48,40">
            <TextBlock x:Name="Heading" Style="{StaticResource Diag.Text.Title}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="Subheading" Style="{StaticResource Diag.Text.Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,6,0,16" />
            <WrapPanel x:Name="Counts" Margin="0,0,0,20" />

            <Border Style="{StaticResource Diag.Card}" Padding="20,8">
                <ItemsControl x:Name="ResultList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <c:StatusIcon Outcome="{Binding Outcome}" VerticalAlignment="Top" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Diag.Text.BodyStrong}" Text="{Binding Title}" Margin="0,0,16,0" />
                                <TextBlock Grid.Column="2" Style="{StaticResource Diag.Text.Body}" Text="{Binding DetailText}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
