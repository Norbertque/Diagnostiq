<UserControl x:Class="Diagnostiq.AutoRun.SummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:Diagnostiq.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="960" Margin="48,40,48,40">
            <TextBlock x:Name="Heading" Style="{StaticResource Diag.Text.Title}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="Subheading" Style="{StaticResource Diag.Text.Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,6,0,16" />

            <ContentControl x:Name="ScoreHost" Focusable="False" IsTabStop="False" />

            <!-- Saved report: where it went and how to open it. -->
            <Border Style="{StaticResource Diag.Banner.Info}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Document24" FontSize="20" Margin="0,1,12,0" VerticalAlignment="Top"
                                   Foreground="{DynamicResource Diag.InfoForegroundBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ReportTitle" Style="{StaticResource Diag.Text.BodyStrong}" Text="Saving the report…" />
                        <TextBlock x:Name="ReportPath" Style="{StaticResource Diag.Text.Caption}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel x:Name="ReportActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                                Visibility="Collapsed">
                        <ui:Button Appearance="Primary" Content="Open report" Icon="{ui:SymbolIcon Open24}" MinHeight="40" Padding="16,8"
                                   Click="OpenReport_Click" />
                        <ui:Button Content="Show in folder" MinHeight="40" Padding="16,8" Margin="8,0,0,0" Click="ShowFolder_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <WrapPanel x:Name="Counts" Margin="0,0,0,12" />
            <Border Style="{StaticResource Diag.Card}" Padding="20,8">
                <ItemsControl x:Name="ResultList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <c:StatusIcon Outcome="{Binding Outcome}" VerticalAlignment="Top" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Diag.Text.BodyStrong}" Text="{Binding Title}" Margin="0,0,16,0" />
                                <TextBlock Grid.Column="2" Style="{StaticResource Diag.Text.Body}" Text="{Binding DetailText}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
