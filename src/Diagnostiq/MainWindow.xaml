<ui:FluentWindow x:Class="Diagnostiq.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Diagnostiq"
                 Width="1180" Height="780" MinWidth="900" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Diagnostiq">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/icon.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Views (loading, home, details) are swapped in here by Navigate(). -->
        <ContentControl x:Name="Host" Grid.Row="1" Focusable="False" IsTabStop="False" />

        <ui:SnackbarPresenter x:Name="SnackbarHost" Grid.Row="1" VerticalAlignment="Bottom" />
        <ui:ContentDialogHost x:Name="DialogHost" Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
