<?xml version="1.0" encoding="utf-8"?>
<!-- Portable release: one self-contained, elevated Diagnostiq.exe in <repo>\publish. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\</PublishDir>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Compression halves the exe (83 MB vs 182 MB) for ~0.25 s of decompression before the splash.
         Measured 2026-09-30 on a Latitude 7430: splash at 0.30 s (0.41 s cold) vs 0.06 s uncompressed;
         well inside the 1 s target, and less to read from a slow USB stick. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Precompiled code: less JIT work at startup on old CPUs. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <!-- Keep Diagnostiq.Core.pdb (a project reference symbol file) out of the publish folder. -->
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
</Project>
