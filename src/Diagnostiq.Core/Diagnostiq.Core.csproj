<Project Sdk="Microsoft.NET.Sdk">

  <!-- UI-free services: hardware probes, stress/storage tests, scoring, reporting. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Diagnostiq.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="ManagedNativeWifi" Version="3.0.2" />
    <!-- NAudio sub-packages only: the NAudio metapackage pulls in WinForms. -->
    <PackageReference Include="NAudio.Core" Version="3.1.0" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Diagnostiq.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Signed PawnIO driver setup 2.2.0 (GPL-2.0, github.com/namazso/PawnIO.Setup), shipped unmodified. -->
    <EmbeddedResource Include="Resources\PawnIO_setup.exe" LogicalName="PawnIO_setup.exe" />
  </ItemGroup>

</Project>
